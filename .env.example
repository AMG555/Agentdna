# AgentDNA local-first runtime configuration
PORT=8000
AGENTDNA_LOCAL_ONLY=true
AGENTDNA_RETENTION_DAYS=30
AGENTDNA_MAX_SUGGESTIONS_PER_HOUR=4

# AI modes: disabled | mock | ollama | openai_compatible | openrouter
# Mock is safe for demos; no network call is made.
AGENTDNA_LLM_MODE=mock
AGENTDNA_LLM_BASE_URL=http://127.0.0.1:11434
AGENTDNA_LLM_MODEL=llama3.2
AGENTDNA_LLM_API_KEY=
AGENTDNA_APP_URL=http://127.0.0.1:8000
AGENTDNA_APP_NAME=AgentDNA
# For OpenRouter, use:
# AGENTDNA_LLM_MODE=openrouter
# AGENTDNA_LLM_BASE_URL=https://openrouter.ai/api/v1
# AGENTDNA_LLM_MODEL=anthropic/claude-sonnet-4
# Store API credentials in the OS keychain in production; do not commit them.
